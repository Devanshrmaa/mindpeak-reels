# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
seo-reports/outreach-sent.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local agent workspaces (transient worktrees / state)
# Claude Code: share project commands, keep local settings/state private
.claude/*
!.claude/commands/
!.claude/skills/

# Next.js build output & TS incremental cache (regenerated by every build)
.next/
*.tsbuildinfo

# Python bytecode cache (generated when running the .claude/skills tools)
__pycache__/
*.pyc

# transient probe files written by scripts/*-audit|sync
scripts/.*-probe.mts
